eligible_job_statuses := {
  "Completed", "Completed", "Completed", "Completed", "Closed"
}

random_integer := fun(min, max) {
	ret min + elf.to_integer(elf.random.random() * (max - min))
}

random_choice := fun(arr) {
	ret arr[elf.to_integer(elf.random.random() * arr:length())]
}

random_job_value := fun() {
	band := random_integer(0, 10)
	value := 0
	  if band < 5 ? value = random_integer(250, 7500)
	elif band < 8 ? value = random_integer(7500, 25000)
	elif band < 9 ? value = random_integer(25000, 75000)
	else value = random_integer(75000, 200000)
	ret value
}

pad2 := fun(value) {
	result := f"${value}"
	if value < 10 ? result = f"0${value}"
	ret result
}

date_days_ago := fun(days_ago) {
	month := 8
	day := 16 - days_ago
	while day <= 0 ? {
		month -= 1
		days_in_month := 31
		if month == 6 ? days_in_month = 30
		day += days_in_month
	}
	ret f"2026-${pad2(month)}-${pad2(day)}T15:00:00Z"
}

make_company_name := fun() {

	adjective := random_choice(company_adjectives)
	family_name := random_choice(family_names)
	noun := random_choice(company_nouns)
	suffix := random_choice(company_suffixes)

	formats := {
		f"${adjective} ${noun}",
		f"${adjective} ${noun} ${suffix}",
		f"${family_name} ${noun}",
		f"${family_name} & Sons",
		f"${family_name} ${noun} ${suffix}",
		f"${adjective} ${family_name} ${noun}",
		f"${adjective} ${noun} Group",
		f"${adjective} ${noun} Partners",
	}

	ret random_choice(formats)
}

customers := {}
for i := 0 ... 30 ? {
	customers:add({
		id = f"C-${10000 + i}",
		name = make_company_name(),
		status = "active"
	})
}

jobs := {}
invoices := {}
invoice_counter := 5000

for i := 0 ... 100 ? {
	customer := random_choice(customers)
	job_id := f"J-${1000 + i}"
	job_total := random_job_value()
	scenario := random_integer(0, 100)
	completed_days_ago := random_integer(1, 91)
	if scenario >= 93 && completed_days_ago < 21 ? completed_days_ago = random_integer(21, 91)
	completed_at := date_days_ago(completed_days_ago)
	job_status := random_choice(eligible_job_statuses)

	job := {
		id = job_id,
		customer_id = customer.id,
		description = random_choice(job_types),
		status = job_status,
		total = job_total,
		currency = "USD",
		completed_at = completed_at
	}
	jobs:add(job)

	// The scenario controls only the source records we emit. It is deliberately
	// not written to the export; LeakCheck must infer discrepancies itself.
	if scenario >= 85 && scenario < 93 ? {
		invoice_total := random_integer(100, job_total)
		invoice_age := completed_days_ago - random_integer(0, 6)
		if invoice_age < 0 ? invoice_age = 0
		invoices:add({
			id = f"INV-${invoice_counter}",
			job_id = job.id,
			customer_id = job.customer_id,
			status = "sent",
			total = invoice_total,
			currency = "USD",
			created_at = date_days_ago(invoice_age)
		})
		invoice_counter += 1
	}
	elif scenario >= 93 ? {
		invoice_age := completed_days_ago - random_integer(0, 4)
		invoices:add({
			id = f"INV-${invoice_counter}",
			job_id = job.id,
			customer_id = job.customer_id,
			status = "draft",
			total = job.total,
			currency = "USD",
			created_at = date_days_ago(invoice_age)
		})
		invoice_counter += 1
	}
	elif scenario >= 75 && scenario < 85 ? {
		// Missing invoice: emit no matching accounting record.
	}
	elif scenario >= 65 ? {
		first_total := random_integer(100, job_total)
		second_total := job_total - first_total
		invoice_age := completed_days_ago - random_integer(0, 6)
		if invoice_age < 0 ? invoice_age = 0
		invoices:add({
			id = f"INV-${invoice_counter}",
			job_id = job.id,
			customer_id = job.customer_id,
			status = "sent",
			total = first_total,
			currency = "USD",
			created_at = date_days_ago(invoice_age)
		})
		invoice_counter += 1
		invoices:add({
			id = f"INV-${invoice_counter}",
			job_id = job.id,
			customer_id = job.customer_id,
			status = "sent",
			total = second_total,
			currency = "USD",
			created_at = date_days_ago(invoice_age)
		})
		invoice_counter += 1
	}
	else {
		invoice_age := completed_days_ago - random_integer(0, 6)
		if invoice_age < 0 ? invoice_age = 0
		invoice_status := random_choice({"sent", "paid", "paid"})
		invoices:add({
			id = f"INV-${invoice_counter}",
			job_id = job.id,
			customer_id = job.customer_id,
			status = invoice_status,
			total = job.total,
			currency = "USD",
			created_at = date_days_ago(invoice_age)
		})
		invoice_counter += 1
	}
}

o := ""
o += ("{") + "\n"
o += ("  \"company\": {\"id\": \"COMP-001\", \"name\": \"Acme HVAC\", \"currency\": \"USD\"},") + "\n"
o += ("  \"crm_export\": {") + "\n"
o += ("    \"source\": \"HubSpot\",") + "\n"
o += ("    \"exported_at\": \"2026-08-16T18:30:00Z\",") + "\n"
o += ("    \"customers\": [") + "\n"
for i := 0 ... customers:length() ? {
	customer := customers[i]
	comma          := ","
	if i == customers:length() - 1 ? comma = ""
	o += (f"      {\"id\": \"${customer.id}\", \"name\": \"${customer.name}\", \"status\": \"${customer.status}\"}${comma}") + "\n"
}
o += ("    ],") + "\n"
o += ("    \"jobs\": [") + "\n"
for i := 0 ... jobs:length() ? {
	job := jobs[i]
	comma := ","
	if i == jobs:length() - 1 ? comma = ""
	o += (f"      {\"id\": \"${job.id}\", \"customer_id\": \"${job.customer_id}\", \"description\": \"${job.description}\", \"status\": \"${job.status}\", \"total\": ${job.total}, \"currency\": \"${job.currency}\", \"completed_at\": \"${job.completed_at}\"}${comma}") + "\n"
}
o += ("    ]") + "\n"
o += ("  },") + "\n"
o += ("  \"accounting_export\": {") + "\n"
o += ("    \"source\": \"QuickBooks Online\",") + "\n"
o += ("    \"exported_at\": \"2026-08-16T18:30:00Z\",") + "\n"
o += ("    \"invoices\": [") + "\n"
for i := 0 ... invoices:length() ? {
	invoice := invoices[i]
	comma := ","
	if i == invoices:length() - 1 ? comma = ""
	o += (f"      {\"id\": \"${invoice.id}\", \"job_id\": \"${invoice.job_id}\", \"customer_id\": \"${invoice.customer_id}\", \"status\": \"${invoice.status}\", \"total\": ${invoice.total}, \"currency\": \"${invoice.currency}\", \"created_at\": \"${invoice.created_at}\"}${comma}") + "\n"
}
o += ("    ]") + "\n"
o += ("  }") + "\n"
o += ("}") + "\n"

elf.fs.write_text_file("src/lib/server/data/company-export.json", o)
